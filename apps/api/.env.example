# API de Inventra. Copia este archivo como .env en apps/api/.
# Nunca subas el .env real: contiene secretos.

# Conexión a PostgreSQL (local: la de docker compose up -d).
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/inventra

# Secreto para firmar las sesiones (mínimo 32 caracteres, genera uno propio).
JWT_SECRET=TU_SECRETO_DE_AL_MENOS_32_CARACTERES

# Orígenes permitidos para el front, separados por comas.
CORS_ORIGIN=http://localhost:5173

# Puerto de la API (opcional, por defecto 4000).
PORT=4000

# Usuario administrador inicial que crea el seed (db:seed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TU_CONTRASENA_DE_ADMINISTRADOR
